          "address" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "kind" : {
            "type" : [ "string", "null" ]
          },
          "stateful" : {
            "type" : "boolean"
          }
        }
      },
      "ForkRequest" : {
        "type" : "object",
        "required" : [ "target" ],
        "properties" : {
          "target" : {
            "type" : "string"
          },
          "fromVersion" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "MapDto" : {
        "type" : "object",
        "required" : [ "address", "displayName", "kind", "trust", "ownerSub", "createdAt" ],
        "properties" : {
          "address" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "stateful" : {
            "type" : "boolean"
          },
          "trust" : {
            "type" : "string"
          },
          "ownerSub" : {
            "type" : "string"
          },
          "forkedFrom" : {
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "MovePinRequest" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "PublishVersionRequest" : {
        "type" : "object",
        "required" : [ "bundleSha256" ],
