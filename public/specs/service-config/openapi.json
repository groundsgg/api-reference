                }
              }
            }
          },
          "404" : {
            "description" : "No such document."
          }
        }
      }
    },
    "/v1/config/apps/{app}/envs/{env}/namespaces/{namespace}/snapshot" : {
      "get" : {
        "summary" : "Read one namespace of an app's documents",
        "tags" : [ "Config" ],
        "parameters" : [ {
          "name" : "app",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        }, {
