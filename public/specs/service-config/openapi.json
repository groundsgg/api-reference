    "/v1/config/apps/{app}/envs/{env}/snapshot" : {
      "get" : {
        "summary" : "Read every document for an app and environment",
        "description" : "The response carries an `ETag` holding the snapshot's version. Send it back as `If-None-Match` and an unchanged snapshot answers 304 with no body — which is how a polling service avoids re-reading configuration that has not moved.",
        "tags" : [ "Config" ],
        "parameters" : [ {
          "name" : "app",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : [ "string", "null" ]
          }
